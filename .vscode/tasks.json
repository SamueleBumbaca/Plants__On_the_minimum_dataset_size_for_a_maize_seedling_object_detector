{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Initialize and Set PYTHONPATH",
            "type": "shell",
            "command": "source ${env:CONDA_PREFIX}/etc/profile.d/conda.sh && conda activate virtual_env && export PYTHONPATH=\"${workspaceFolder}/src\"",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}